{
  "name": "posse",
  "private": true,
  "version": "0.1.0",
  "description": "POSSE conditional group-purchase vault on Solana: Anchor program, TypeScript client, indexer decoding layer",
  "license": "MIT",
  "scripts": {
    "build": "anchor build",
    "test": "npm run test:program && npm run test:sdk",
    "test:program": "tsx --test tests/program/litesvm.test.ts",
    "test:sdk": "tsx --test tests/sdk/*.test.ts",
    "test:mutation": "bash scripts/mutation-control.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync-idl": "bash scripts/sync-idl.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "3.1.0",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@solana/kit": "8.5.0",
    "@types/node": "22.18.0",
    "litesvm": "1.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
